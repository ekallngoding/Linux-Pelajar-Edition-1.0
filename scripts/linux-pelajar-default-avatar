#!/bin/sh
set -eu

AVATAR="/usr/share/pixmaps/linux-pelajar-user.png"
FOUND=0

[ -r "$AVATAR" ] || exit 1

mkdir -p /var/lib/AccountsService/icons
mkdir -p /var/lib/AccountsService/users
mkdir -p /usr/share/sddm/faces

while IFS=: read -r username password uid gid gecos home shell; do

    case "$uid" in
        ''|*[!0-9]*) continue ;;
    esac

    [ "$uid" -ge 1000 ] || continue
    [ "$uid" -lt 60000 ] || continue
    [ -d "$home" ] || continue

    case "$shell" in
        */nologin|*/false) continue ;;
    esac

    ICON="/var/lib/AccountsService/icons/$username"
    CONF="/var/lib/AccountsService/users/$username"
    FACE="/usr/share/sddm/faces/$username.face.icon"

    install -o root -g root -m 644 "$AVATAR" "$ICON"
    install -o root -g root -m 644 "$AVATAR" "$FACE"

    install -o "$uid" -g "$gid" -m 644 \
        "$AVATAR" "$home/.face.icon"

    if [ ! -f "$CONF" ]; then
        printf '[User]\nIcon=%s\nSystemAccount=false\n' \
            "$ICON" > "$CONF"

    elif grep -q '^Icon=' "$CONF"; then
        sed -i "s|^Icon=.*|Icon=$ICON|" "$CONF"

    elif grep -q '^\[User\]' "$CONF"; then
        sed -i "/^\[User\]/a Icon=$ICON" "$CONF"

    else
        printf '\n[User]\nIcon=%s\n' "$ICON" >> "$CONF"
    fi

    chmod 644 "$CONF"
    FOUND=1

done < /etc/passwd

[ "$FOUND" -eq 1 ] || exit 0

touch /var/lib/linux-pelajar-avatar-configured
